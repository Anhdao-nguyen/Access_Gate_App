# Vercel Ignore File
# Files and folders to exclude from deployment

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Documentation (optional - remove if you want docs deployed)
docs/
*.md
!README.md

# Development
.git/
.gitignore
nodemon.json

# Build artifacts
dist/
build/
.next/

# Testing
coverage/
.nyc_output/
test/
*.test.js
*.spec.js
